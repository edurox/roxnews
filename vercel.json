{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/spa",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/enriquecer-thumbs?quantidade=100",
      "schedule": "0 6 * * *"
    }
  ]
}
